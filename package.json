{
  "name": "create-vite-lustre",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Create new vitejs + lustre + gleam",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "minify": false,
    "clean": true
  },
  "bin": {
    "create-vite-lustre": "./index.js"
  },
  "files": [
    "dist",
    "template",
    "template-react",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "@gleam-br",
    "email": "contato@gleam.dev.br"
  },
  "keywords": [
    "vite",
    "gleam",
    "javascript",
    "create-gleam",
    "create-vite-gleam"
  ],
  "repository": {
    "url": "git+https://github.com/gleam-br/create-vite-lustre.git"
  },
  "bugs": {
    "url": "https://github.com/gleam-br/create-vite-lustre/issues"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "execa": "^10.0.1",
    "mri": "^1.2.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}